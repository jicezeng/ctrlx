# Required Caddy environment: CTRLX_UPDATES_HOST
{$CTRLX_UPDATES_HOST} {
    root * {$CTRLX_UPDATES_ROOT:/opt/ctrlx-updates}
    file_server
    encode gzip

    log {
        output file /var/log/caddy/ctrlx-updates-access.log
        format json
    }

    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
    }
}
