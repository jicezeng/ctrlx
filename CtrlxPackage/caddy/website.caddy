# Required Caddy environment: CTRLX_SITE_HOST
{$CTRLX_SITE_HOST} {
    root * {$CTRLX_SITE_ROOT:/opt/ctrlx-website}
    file_server
    encode gzip

    log {
        output file /var/log/caddy/ctrlx-website-access.log
        format json
    }

    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
    }

    @immutable path /_astro/* /fonts/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    handle_errors 404 {
        rewrite * /404.html
        file_server
    }
}
