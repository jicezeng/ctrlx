<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CtrlXBuildStamp</key>
	<string>$(CTRLX_BUILD_STAMP)</string>
	<key>CtrlXSourceRevision</key>
	<string>$(CTRLX_SOURCE_REVISION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>CtrlX uses the microphone only while you hold the voice input button.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>CtrlX converts speech into editable text on your device.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.jicezeng.ctrlx.refresh</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).agent-monitor.*</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
</dict>
</plist>
