# CtrlX release/deployment configuration.
# Copy to exactly one active file: .env.local, .env.production,
# .env.development or .env.test. The first existing file wins.

# Apple release identity (private credentials stay in Keychain, not here).
CTRLX_MAC_DEVELOPMENT_TEAM=YOUR_TEAM_ID
CTRLX_MAC_SIGNING_IDENTITY=Developer ID Application: YOUR_NAME (YOUR_TEAM_ID)
CTRLX_NOTARYTOOL_PROFILE=ctrlx-notary

# Owned download infrastructure. Keep empty until DNS/TLS actually exists.
CTRLX_DOWNLOAD_URL_PREFIX=

# Private macOS package publication to the home Mac that owns the Nginx bind
# mount. These defaults match deploy2home.sh and may be overridden here.
CTRLX_PUBLISH_HOST=192.168.31.5
CTRLX_PUBLISH_REMOTE_DIR=/Users/zengjice/Work/happy-nginx/deploy/ctrlx
CTRLX_PUBLISH_PUBLIC_BASE=https://ctrlx.zengjice.com:7001/install
CTRLX_PUBLISH_RELAY_URL=wss://ctrlx.zengjice.com:7001

# Relay deployment over SSH.
CTRLX_DEPLOY_HOST=
CTRLX_DEPLOY_USER=root
CTRLX_RELAY_REMOTE_DIR=/opt/ctrlx
CTRLX_RELAY_HEALTH_URL=

# Optional: install the generic Caddy site file. The Caddy service itself must
# receive CTRLX_RELAY_HOST through its own audited system configuration.
CTRLX_CADDY_CONF_DIR=
